# =================================================================
# Bybit & OKX Hacim ve Maliyet Takip Sistemi - Ortam Değişkenleri
# NOT: Yalnızca "Sadece Okuma" (Read-Only) yetkili API anahtarları kullanınız!
# Para çekme veya alım-satım izinleri KESİNLİKLE GEREKMEZ.
# =================================================================

# Bybit V5 API Bilgileri (Read-Only)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# OKX V5 API Bilgileri (Read-Only)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_IS_SIMULATED=false

# Google Gemini API Anahtarı (İsteğe Bağlı - AI Duyuru ve Anomali Analizi için)
GEMINI_API_KEY=

# Excel Dosya Yolu (Varsayılan: bybit-okx_maliyet.xlsx)
EXCEL_FILE_PATH=bybit-okx_maliyet.xlsx

# Yerel Sunucu Ayarları
HOST=127.0.0.1
PORT=8000
AUTO_SYNC_INTERVAL_MINUTES=15
